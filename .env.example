# Image API Configuration
# Single endpoint mode (simple)
IMAGE_API_BASE=https://your-provider.com/v1
IMAGE_API_KEY=sk-your-api-key-here

# Optional
IMAGE_MODEL=gpt-image-2
IMAGE_OUT_DIR=/tmp/gptimage

# Primary + Fallback mode (high availability)
# PRIMARY_IMAGE_API_BASE=http://localhost:8080/v1
# PRIMARY_IMAGE_API_KEY=your-primary-key
# IMAGE_API_BASE=https://your-remote-provider.com/v1
# IMAGE_API_KEY=your-backup-key
